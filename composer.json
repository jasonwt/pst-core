{
    "name": "jasonwt/pst-core",
    "description": "PST shared core abstractions",
    "keywords": [
        "php",
        "core",
        "collections",
        "linq"
    ],
    "type": "library",
    "license": "MIT",
    "scripts": {
        "test": "php vendor/bin/phpunit tests"
    },
    "autoload": {
        "psr-4": {
            "PST\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PST\\Core\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.1"
    }
}
